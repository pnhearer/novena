#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
layout(local_size_x=64) in;
#if SHAPE == 0
layout(set=0,binding=0) uniform usampler2D image;
#elif SHAPE == 1
layout(set=0,binding=0) uniform usampler2DArray image;
#elif SHAPE == 2
layout(set=0,binding=0) uniform usampler3D image;
#elif SHAPE == 3
layout(set=0,binding=0) uniform usamplerCube image;
#else
layout(set=0,binding=0) uniform usamplerCubeArray image;
#endif
layout(buffer_reference,std430,buffer_reference_align=4) buffer Output { uint pixels[]; };
layout(push_constant,std430) uniform P { uint64_t address; uint width; uint height; uint depth; uint layer; uint level; uint offset; } p;
void main() {
    uint at=gl_GlobalInvocationID.x;
    if(at>=p.width*p.height*p.depth) return;
    uint x=at%p.width, y=(at/p.width)%p.height, z=at/(p.width*p.height);
    uvec4 pixel;
#if SHAPE == 0
    pixel=texelFetch(image,ivec2(x,y),int(p.level));
#elif SHAPE == 1
    pixel=texelFetch(image,ivec3(x,y,p.layer),int(p.level));
#elif SHAPE == 2
    pixel=texelFetch(image,ivec3(x,y,z),int(p.level));
#else
    float s=2.0*(float(x)+0.5)/float(p.width)-1.0;
    float t=2.0*(float(y)+0.5)/float(p.height)-1.0;
    vec3 direction;
    uint face=p.layer%6;
    if(face==0) direction=vec3(1,-t,-s);
    else if(face==1) direction=vec3(-1,-t,s);
    else if(face==2) direction=vec3(s,1,t);
    else if(face==3) direction=vec3(s,-1,-t);
    else if(face==4) direction=vec3(s,-t,1);
    else direction=vec3(-s,-t,-1);
#if SHAPE == 3
    pixel=textureLod(image,direction,float(p.level));
#else
    pixel=textureLod(image,vec4(direction,float(p.layer/6)),float(p.level));
#endif
#endif
    Output(p.address).pixels[p.offset/4+at]=pixel.r|(pixel.g<<8)|(pixel.b<<16)|(pixel.a<<24);
}
